package(default_visibility = ["//visibility:public"])

# Ensure `bazel build //...` also builds DEM-Engine, even if nothing depends on it yet.
alias(
    name = "dem_engine",
    actual = "@dem_engine//:dem_engine",
)


alias(
    name = "chrono_batch_render",
    actual = "@chrono_batch_render//:chrono_batch_render",
)

alias(
    name = "chrono_batch_render_viewer",
    actual = "@chrono_batch_render//:viewer",
)
