module(
    name = "new_ancf",
    version = "0.1",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_cuda", version = "0.2.5")
bazel_dep(name = "rules_foreign_cc", version = "0.9.0")
bazel_dep(name = "eigen", version = "3.4.0.bcr.3")
bazel_dep(name = "googletest", version = "1.17.0")

# Bazel 9 no longer exposes `CcInfo` as a global; `rules_cuda` v0.2.5 still
# assumes it is. Patch the module to explicitly load it from `@rules_cc`.
single_version_override(
    module_name = "rules_cuda",
    patch_strip = 1,
    patches = ["//:rules_cuda_0.2.5_bazel9.patch"],
    version = "0.2.5",
)

single_version_override(
    module_name = "rules_foreign_cc",
    patch_strip = 1,
    patches = ["//:rules_foreign_cc_0.9.0_bazel9_v3.patch"],
    version = "0.9.0",
)

single_version_override(
    module_name = "googletest",
    patch_strip = 1,
    patches = ["//:googletest_1.17.0_bazel9.patch"],
    version = "1.17.0",
)

# Bring the CMake-based DEM-Engine submodule into Bazel without adding BUILD files
# inside the submodule itself.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "dem_engine",
    build_file = "//third_party:dem_engine.BUILD.bazel",
    path = "third_party/DEM-Engine",
)

# Chrono Batch Render prebuilt C++ release, used by the live viewer demos.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "chrono_batch_render",
    build_file = "//third_party:chrono_batch_render.BUILD.bazel",
    sha256 = "57c223e49cb8573ddac84fde0be168737046f21230972fd54e69d823026003de",
    strip_prefix = "chrono-batch-render-0.1.0-Linux-x86_64",
    url = "https://github.com/uwsbel/chrono-batch-render/releases/download/v0.1.0/chrono-batch-render-0.1.0-Linux-x86_64.tar.gz",
)

# Register CUDA toolchains provided by rules_cuda
register_toolchains("@rules_cuda//cuda:all")
